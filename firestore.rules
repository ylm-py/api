rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // S3 : chaque utilisateur ne voit et ne modifie que son stock
    match /products/{productId} {
      // lecture / suppression : le document existe déjà -> resource.data
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      // création : le document n'existe pas encore -> request.resource.data
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      // modification : le userId doit rester identique
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    // Mini défi S5-3 : liste de courses (même principe)
    match /shoppingList/{itemId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }
  }
}
